# PostgreSQL connection: use the Supabase Transaction Pooler URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY
SUPABASE_BUCKET=jewellery_images
MAX_IMAGE_MB=8
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
